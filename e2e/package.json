{
  "name": "@tsa/e2e",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:extension": "playwright test --config playwright.extension.config.ts",
    "test:extension:chrome": "playwright test --config playwright.extension-chrome.config.ts",
    "test:real-world": "playwright test --config playwright.real-world.config.ts",
    "screenshots": "playwright test --project chromium --grep \"phone gallery\"",
    "screenshots:real-world": "playwright test --config playwright.real-world.config.ts --project chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "playwright-webextext": "^0.0.5"
  }
}
