{
  "name": "@tsa/extension",
  "version": "1.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode content && vite build --mode background && vite build --mode options && vite build --mode popup",
    "build:chrome": "node build-chrome-variant.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:webext": "web-ext lint --source-dir dist",
    "run:desktop": "web-ext run -t firefox-desktop --source-dir dist",
    "run:android": "web-ext run -t firefox-android --source-dir dist",
    "sign": "node sign.js",
    "release:github": "node release-github.js",
    "amo:listing": "node amo-listing.js",
    "amo:screenshots": "node amo-screenshots.js",
    "chrome:store": "node chrome-store.js",
    "version:bump": "node bump-version.js",
    "icons": "node render-icons.js"
  },
  "dependencies": {
    "@tsa/core": "*",
    "@tsa/stores": "*",
    "@tsa/ui-widget": "*",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "web-ext": "^10.7.0",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/webextension-polyfill": "^0.12.3",
    "playwright": "^1.63.0",
    "vitest": "^5.0.3",
    "jsdom": "^26.1.0"
  }
}
