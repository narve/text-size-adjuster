{
  "name": "@tsa/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build -c vite.content.config.ts && vite build -c vite.background.config.ts && vite build -c vite.options.config.ts && vite build -c vite.popup.config.ts",
    "build:chrome": "node build-chrome-variant.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:webext": "web-ext lint --source-dir dist",
    "run:desktop": "web-ext run -t firefox-desktop --source-dir dist",
    "run:android": "web-ext run -t firefox-android --source-dir dist",
    "sign": "node sign.mjs"
  },
  "dependencies": {
    "@tsa/core": "*",
    "@tsa/stores": "*",
    "@tsa/ui-widget": "*",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "web-ext": "^10.7.0",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/webextension-polyfill": "^0.12.3"
  }
}
