{
  "name": "@tsa/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:webext": "web-ext lint --source-dir dist",
    "run:desktop": "web-ext run -t firefox-desktop --source-dir dist",
    "run:android": "web-ext run -t firefox-android --source-dir dist"
  },
  "dependencies": {
    "@tsa/core": "*",
    "@tsa/stores": "*",
    "@tsa/ui-widget": "*"
  },
  "devDependencies": {
    "vite": "^6.0.11",
    "web-ext": "^8.3.0",
    "@types/firefox-webext-browser": "^120.0.4"
  }
}
